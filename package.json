{
  "name": "agent-mesh",
  "version": "1.0.0",
  "description": "AI Agent Swarm with Autonomous Wallets on Solana",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "swarm": "ts-node src/swarm.ts",
    "terminal": "ts-node src/terminal.ts",
    "swarm:raw": "concurrently \"AGENT_TYPE=BANKER ts-node src/index.ts\" \"AGENT_TYPE=ARBITRAGEUR ts-node src/index.ts\" \"AGENT_TYPE=TREND ts-node src/index.ts\" \"AGENT_TYPE=LP ts-node src/index.ts\"",
    "dashboard": "node dashboard/server.js",
    "dashboard-old": "ts-node scripts/dashboard.ts",
    "cleanup-archive": "ts-node scripts/cleanup-and-archive.ts",
    "generate-treasury": "ts-node scripts/generate-treasury.ts",
    "setup-treasury": "ts-node scripts/setup-treasury-tokens.ts",
    "demo-data": "ts-node scripts/generate-demo-data.ts",
    "check-treasury": "ts-node scripts/check-treasury.ts",
    "init-interactive": "ts-node scripts/interactive-init.ts",
    "fund-interactive": "ts-node scripts/interactive-fund.ts",
    "fund-quick": "ts-node scripts/quick-fund.ts",
    "check-balances": "ts-node scripts/check-balances.ts",
    "check-banker": "ts-node scripts/check-banker.ts",
    "check-api": "ts-node scripts/test-api.ts",
    "check-all": "ts-node src/pools/checkAllBalances.ts",
    "volatility": "ts-node scripts/volatilityGenerator.ts",
    "create-pool": "ts-node anchor-amm/app/createPool.ts",
    "add-liquidity": "ts-node anchor-amm/app/addLiquidity.ts",
    "swap": "ts-node anchor-amm/app/swap.ts"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.32.1",
    "@metaplex-foundation/js": "^0.20.1",
    "@metaplex-foundation/mpl-token-metadata": "^3.4.0",
    "@solana/spl-memo": "^0.2.5",
    "@solana/spl-token": "^0.4.0",
    "@solana/spl-token-swap": "^0.4.4",
    "@solana/web3.js": "^1.98.0",
    "axios": "^1.6.0",
    "cors": "^2.8.6",
    "decimal.js": "^10.6.0",
    "dotenv": "^16.3.0",
    "express": "^4.22.1",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^20.0.0",
    "concurrently": "^9.2.1",
    "ts-node": "^10.9.0",
    "typescript": "^5.3.0"
  },
  "license": "MIT"
}
