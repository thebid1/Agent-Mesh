# ===========================================
# Agent Mesh - Environment Configuration
# ===========================================

# Solana RPC Configuration
# ------------------------
# Option 1: Use public devnet (default, may be slow)
SOLANA_RPC_URL=https://api.devnet.solana.com

# Option 2: Use Alchemy (recommended for better performance)
# Get your free API key at: https://alchemy.com/solana
# SOLANA_RPC_URL=https://solana-devnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY

# Wallet Encryption (REQUIRED)
# ---------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WARNING: Without this key, wallets are UNRECOVERABLE!
WALLET_ENCRYPTION_KEY=your_64_character_hex_key_here

# Treasury Configuration
# ----------------------
# Path to encrypted treasury keypair file
TREASURY_KEYPAIR_PATH=./treasury-keypair.enc.json

# How much SOL is in the treasury (used for validation)
TREASURY_BALANCE_SOL=0

# How much SOL to fund each agent initially
FUND_PER_AGENT_SOL=2.5

# AI Configuration (Gemini) - Optional
# -------------------------
# Get your API key from: https://aistudio.google.com/app/apikey
# Leave empty if not using AI features
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Logging Configuration
# -------------------------------
# Log levels: debug, info, warn, error
LOG_LEVEL=info

# Optional: Network Settings
# --------------------------
# Confirmation commitment level: processed, confirmed, finalized
COMMITMENT=confirmed

# Optional: Circuit Breaker Settings
# ----------------------------------
# Max daily loss percentage before pausing agents
MAX_DAILY_LOSS_PERCENT=10

# Max consecutive transaction failures before pausing
MAX_CONSECUTIVE_FAILURES=5
